# -----------------------------------------------------------------------------
# n8n-hubspot-lead-timezone-dispatch-validator
# Copy to .env (git-ignored) for the Node.js mirror, or set the same variables on
# the n8n host. Every credential below is a placeholder.
# Out of the box nothing is written or sent: DRY_RUN=true, SANDBOX_MODE=true,
# IP_TIMEZONE_PROVIDER=none, and unresolved leads go to manual review.
# -----------------------------------------------------------------------------

# --- Safety switches (anything other than an explicit false keeps them on)
DRY_RUN=true
SANDBOX_MODE=true

# --- Intake webhook
WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE
WEBHOOK_SECRET_HEADER=x-webhook-secret
WEBHOOK_MAX_BODY_BYTES=262144

# --- Node.js mirror only
PORT=3000
QUEUE_POLL_SECONDS=60

# --- HubSpot (Private App)
HUBSPOT_PRIVATE_APP_TOKEN=YOUR_HUBSPOT_PRIVATE_APP_TOKEN_HERE
HUBSPOT_SANDBOX_PORTAL_ID=YOUR_HUBSPOT_SANDBOX_PORTAL_ID_HERE
HUBSPOT_BASE_URL=https://api.hubapi.com
HUBSPOT_WRITE_PROPERTIES=true

# --- Timezone resolution
# Order of signals: explicit (payload timezone / hs_timezone), region (country + state), phone, country, ip
RESOLUTION_ORDER=explicit,region,phone,country,ip
# conservative: merge a disagreeing second signal into the candidate zones | precedence: trust the first signal
CONFLICT_POLICY=conservative
CONFLICT_THRESHOLD_HOURS=2
# manual: unresolved leads go to manual review | default: treat them as DEFAULT_TIMEZONE
UNKNOWN_TIMEZONE_ACTION=manual
DEFAULT_TIMEZONE=UTC
# ISO country for national-format phone numbers without a +country code (empty = ignore them)
DEFAULT_PHONE_COUNTRY=
# none | header (edge sets the visitor timezone, e.g. Cloudflare cf-timezone) | ipinfo
IP_TIMEZONE_PROVIDER=none
IP_TIMEZONE_HEADER=cf-timezone
IPINFO_TOKEN=YOUR_IPINFO_TOKEN_HERE
IP_LOOKUP_TIMEOUT_MS=1500

# --- Outbound windows (recipient local time, 24h HH:MM)
CALL_WINDOW_START=09:00
CALL_WINDOW_END=18:00
EMAIL_WINDOW_START=09:00
EMAIL_WINDOW_END=18:00
# call | email | both (intersection) when the payload does not specify a channel
DEFAULT_CHANNEL=both
# ISO weekdays, 1 = Monday
ALLOWED_WEEKDAYS=1,2,3,4,5
# Per-country and global ("*") holidays, YYYY-MM-DD
HOLIDAYS_JSON={"US":["2026-11-26","2026-12-25"],"GB":["2026-12-25","2026-12-28"],"*":["2027-01-01"]}
# Do not dispatch in the last N minutes of a window
WINDOW_END_BUFFER_MINUTES=30
# Spread dispatches over the first N minutes of a window (deterministic per contact)
DISPATCH_JITTER_MINUTES=15
# Longer delays go to manual review
MAX_DELAY_HOURS=96
MAX_WAIT_CYCLES=3

# --- Dispatch hand-off (HTTPS webhook to your sequencer / dialer / HubSpot workflow trigger)
DISPATCH_WEBHOOK_URL=YOUR_DISPATCH_WEBHOOK_URL_HERE
DISPATCH_SANDBOX_WEBHOOK_URL=YOUR_DISPATCH_SANDBOX_WEBHOOK_URL_HERE
DISPATCH_WEBHOOK_SECRET=YOUR_DISPATCH_WEBHOOK_SECRET_HERE
DISPATCH_INCLUDE_EMAIL=false

# --- Offline simulation only
SIMULATE_NOW=2026-11-16T14:00:00Z
